
list all pods
sudo kubectl get pods -o wide

sudo kubectl -n dbp get pods -o wide


sudo install -d -m 0755 /root/.kube
sudo install -m 0600 /etc/rancher/k3s/k3s.yaml /root/.kube/config
sudo kubectl get nodes



./deploy.sh laptop-r10q787a k3s-node ghcr.io/proknapz/k3s-distributed-db-processing/dbp-platform:latest


stop: 

sudo kubectl -n dbp scale deployment/api --replicas=0
sudo kubectl -n dbp scale deployment/worker --replicas=0
sudo kubectl -n dbp scale statefulset/postgres --replicas=0


sudo kubectl delete namespace dbp


sudo kubectl -n dbp scale statefulset/postgres --replicas=1
sudo kubectl -n dbp scale deployment/api --replicas=1

sudo kubectl -n dbp scale deployment/worker --replicas=4  


remove all deployment
sudo kubectl delete -f ./k8s







docker run -d --name dbp-postgres -e POSTGRES_DB=dbp -e POSTGRES_USER=dbp -e POSTGRES_PASSWORD=dbp -p 5432:5432 postgres:16





